/**
 * Runbook: {{RUNBOOK_ID}}
 */

import { logAction } from '../../../actions/ActionFactories.js';
import { RunbookBuilder } from '../../../builders/RunbookBuilder.js';
import { LogStep } from '../../../steps/control/LogStep.js';
import type { Runbook } from '../../../types/Runbook.js';

/**
 * Builds the {{RUNBOOK_ID}} runbook definition.
 *
 * @returns A validated {@link Runbook} ready for execution
 */
export function buildRunbook(): Runbook {
  return (
    RunbookBuilder.create('{{RUNBOOK_ID}}')
      .metadata({
        name: '{{METADATA_NAME}}',
        description: '{{METADATA_DESCRIPTION}}',
        version: '{{METADATA_VERSION}}',
        type: 'alarm-resolution',
        team: '{{METADATA_TEAM}}',
        tags: {{METADATA_TAGS}},
      })
      // TODO: add data/check/transform steps, e.g. .step(new CloudWatchLogsQueryStep({ ... })).
      // A runbook needs at least one step and a fallback action to build.
      .step(
        new LogStep({
          id: 'start',
          label: 'Avvio analisi {{RUNBOOK_ID}}',
          level: 'info',
          message: 'TODO: implementare gli step di analisi per {{RUNBOOK_ID}}',
        }),
      )
      // TODO: add known cases with
      //   .knownCase(knownCase({ id, description, priority, condition, resolution, analysis })).
      .fallback(
        logAction({
          level: 'warn',
          title: '[{{RUNBOOK_ID}}] Nessun caso noto: analisi da completare.',
        }),
      )
      .build()
  );
}
