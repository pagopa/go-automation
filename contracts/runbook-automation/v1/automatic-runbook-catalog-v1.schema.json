{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "AutomaticRunbookCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "publishedAt", "environment", "worker", "release", "runbooks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "environment": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRevision", "commandSchemaVersion"],
      "properties": {
        "artifactRevision": { "type": "string", "minLength": 1 },
        "commandSchemaVersion": { "const": "1.0.0" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorArn", "changeNote"],
      "properties": {
        "actorArn": { "type": "string", "minLength": 1 },
        "changeNote": { "type": "string", "minLength": 1 }
      }
    },
    "runbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "version",
          "name",
          "description",
          "team",
          "kind",
          "categories",
          "tags",
          "alarmNames",
          "definitionDigest"
        ],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "team": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["APIGW", "LAMBDA", "SERVICE"] },
          "categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
          },
          "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "alarmNames": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "definitionDigest": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" }
        }
      }
    }
  }
}
