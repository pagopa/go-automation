{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "AnalysisDraftV1",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "analysisType": {
          "anyOf": [
            {
              "const": "ANALYZABLE",
              "type": "string"
            },
            {
              "const": "IGNORABLE",
              "type": "string"
            }
          ]
        },
        "conclusionNotes": {
          "maxLength": 5000,
          "type": "string"
        },
        "downstreams": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "errorDetails": {
          "maxLength": 5000,
          "type": "string"
        },
        "finalActions": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "ignoreDetails": {
          "patternProperties": {
            "^(.*)$": {}
          },
          "type": "object"
        },
        "ignoreReasonCode": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "KNOWN_CASE",
          "type": "string"
        },
        "links": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "maxLength": 50,
                "type": "string"
              },
              "url": {
                "maxLength": 2000,
                "minLength": 1,
                "pattern": "^https?://",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        },
        "proposedStatus": {
          "anyOf": [
            {
              "const": "IN_PROGRESS",
              "type": "string"
            },
            {
              "const": "COMPLETED",
              "type": "string"
            }
          ]
        },
        "resources": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              "role": {
                "anyOf": [
                  {
                    "const": "PRIMARY",
                    "type": "string"
                  },
                  {
                    "const": "QUERIED",
                    "type": "string"
                  },
                  {
                    "const": "CASE_RELATED",
                    "type": "string"
                  }
                ]
              },
              "type": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        },
        "runbookName": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "conclusionNotes",
        "proposedStatus",
        "analysisType",
        "resources",
        "downstreams",
        "finalActions",
        "links"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "downstreams": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "finalActions": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "kind": {
          "const": "UNKNOWN_CASE_CONTEXT",
          "type": "string"
        },
        "links": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "maxLength": 50,
                "type": "string"
              },
              "url": {
                "maxLength": 2000,
                "minLength": 1,
                "pattern": "^https?://",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        },
        "resources": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              "role": {
                "anyOf": [
                  {
                    "const": "PRIMARY",
                    "type": "string"
                  },
                  {
                    "const": "QUERIED",
                    "type": "string"
                  },
                  {
                    "const": "CASE_RELATED",
                    "type": "string"
                  }
                ]
              },
              "type": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        },
        "runbookName": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "resources",
        "downstreams",
        "finalActions",
        "links"
      ],
      "type": "object"
    }
  ]
}
