# Logical AWS accounts of the multi-account runbooks (EVO-AWSACCT-OPUS-01).
# Synthetic ids: copy this file outside the repository and put the real account ids there.
#
# <product>/<account>/<environment>=<12-digit account id>, comma-separated.
# An account id belongs to one environment only; the environment of an occurrence
# is derived from its account.
AWS_ACCOUNT_DIRECTORY=send/core/prod=000000000101,send/confinfo/prod=000000000102,send/core/uat=000000000201,send/confinfo/uat=000000000202

# profiles (local profiles with any name, matched to the account through STS) or oam.
AWS_ACCOUNT_BINDING=profiles

# Environment read by go-analyze-alarm, which runs without an occurrence account.
AWS_ACCOUNT_ENVIRONMENT=prod

# Preferred SSO permission sets when several profiles reach the same account.
AWS_ACCOUNT_PERMISSION_SETS=ReadOnlyAccess
