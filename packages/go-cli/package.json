{
  "name": "@go-automation/go-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GO Automation CLI - Centralized Control Plane",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "go-cli": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc --build --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --import tsx/esm --test --experimental-test-isolation=none 'src/**/__tests__/**/*.test.ts'",
    "dev": "node --import tsx/esm src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "cli",
    "automation",
    "go-automation"
  ],
  "author": "Team GO - Gestione Operativa",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10.28.0"
  },
  "dependencies": {
    "@go-automation/go-script": "workspace:*",
    "@pagopa/go-common": "workspace:*",
    "commander": "catalog:",
    "fuse.js": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
