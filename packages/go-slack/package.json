{
  "name": "@go-automation/go-slack",
  "version": "1.0.0",
  "private": true,
  "description": "Messaging abstractions with the Slack adapter (reader, writer, messenger).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc --build --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --import tsx/esm --test 'src/**/__tests__/**/*.test.ts'"
  },
  "author": "Team GO - Gestione Operativa",
  "license": "EUPL-1.2",
  "dependencies": {
    "@pagopa/go-common": "workspace:*",
    "@slack/web-api": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
